# 复制为 .env 后启动。不要提交 .env。
# pydantic-settings 从工作目录加载本文件（见 app/config.py Settings）。
# HTTP 监听端口不在本文件：本地 `uv run uvicorn app.main:app --reload --port 4580`，镜像 EXPOSE 4580。
# 应用启动不执行 DDL，先独立迁移：`uv run alembic upgrade head`
# Token 必须与 Backend 的 SKILL_AGENT_INTERNAL_TOKEN 一致。

# --- PostgreSQL（关系数据库）---
# 可与 Backend 共用同一库；Agent 迁移写入 agent.alembic_version，不会覆盖 Backend 的 public.alembic_version。
DATABASE_URL=postgresql+asyncpg://nodeskclaw:nodeskclaw@localhost:5432/nodeskclaw
SKILL_AGENT_SCHEMA=agent

# --- 角色与 Worker（后台认领循环）---
# central：认领 Run 并执行；edge：出站轮询 Backend，不开放生产入站控制端口。
SKILL_AGENT_ROLE=central
SKILL_AGENT_WORKER_ENABLED=true
SKILL_AGENT_WORKER_INTERVAL_SECONDS=1.0
SKILL_AGENT_LEASE_SECONDS=60

# --- 内部鉴权（Internal Token）---
# 生产 /health/ready 拒绝 change-me-skill-agent-token、空值和 default。
# 轮换时把旧值放到 PREVIOUS，新旧 Token 在轮换窗口内均可使用。
SKILL_AGENT_INTERNAL_TOKEN=replace-with-shared-internal-token
SKILL_AGENT_INTERNAL_TOKEN_PREVIOUS=

# --- Backend / 凭证租约（Credential Lease）---
# Central 用于短效凭证签发与就绪探针 /api/health；Edge 出站心跳、认领 EdgeJob 也走此 URL。
# 生产 Edge 必须使用 https://，否则 Worker 启动失败且就绪探针失败。
SKILL_AGENT_CENTRAL_BASE_URL=http://localhost:4510

# --- Artifact StoragePort（工件存储）---
# local：落盘到 ARTIFACT_DIR；s3：使用下方对象存储项。生产禁止 ARTIFACT_DIR 指向 /tmp。
SKILL_AGENT_STORAGE_DRIVER=local
SKILL_AGENT_ARTIFACT_DIR=./data/skill-agent-artifacts
SKILL_AGENT_S3_ENDPOINT=https://s3.example.com
SKILL_AGENT_S3_BUCKET=nodeskclaw-artifacts
SKILL_AGENT_S3_ACCESS_KEY=
SKILL_AGENT_S3_SECRET_KEY=
SKILL_AGENT_S3_REGION=auto

# --- SecretStore（密钥引用解析）---
# 明文可放在该目录下的文件，或环境变量 SKILL_AGENT_SECRET_<REF_ID>（非字母数字会变成下划线并大写）。
SKILL_AGENT_SECRET_STORE=./.skill-agent-secrets

# --- Edge（仅 SKILL_AGENT_ROLE=edge 必填）---
# NODE_ID 与 TOKEN 必须对应 Backend 已注册的 Edge Node。
SKILL_AGENT_EDGE_TOKEN=
SKILL_AGENT_EDGE_NODE_ID=
SKILL_AGENT_EDGE_POLL_SECONDS=2.0
# Spool（磁盘暂存信封）与本地 Skill 安装目录当前硬编码为 ./data/edge_spool 与 ./data/edge_skills。

# --- 生产门禁 ---
# true 仅本地或验收拓扑。false 时拒绝默认 Token、/tmp Artifact、Edge 缺 Token/Node、非 https Central URL。
SKILL_AGENT_INSECURE_MODE=true
