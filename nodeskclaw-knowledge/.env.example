APP_NAME=nodeskclaw-knowledge
APP_VERSION=dev
DEBUG=false
HOST=0.0.0.0
PORT=4530

DATABASE_URL=postgresql+asyncpg://nodeskclaw:nodeskclaw@postgres:5432/nodeskclaw_knowledge
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20

NODESKCLAW_BACKEND_URL=http://nodeskclaw-backend:8000
NODESKCLAW_KNOWLEDGE_CONTEXT_PATH=/api/v1/auth/knowledge-context
MEMBER_CONTEXT_TTL_SECONDS=0

RAGFLOW_BASE_URL=http://ragflow:9380
RAGFLOW_API_KEY=
RAGFLOW_TIMEOUT_SECONDS=60
RAGFLOW_UPLOAD_TIMEOUT_SECONDS=120

LLM_PROXY_URL=http://llm-proxy:8080
LLM_PROXY_PROVIDER=openai
KNOWLEDGE_SERVICE_TOKEN=

KNOWLEDGE_UPLOAD_MAX_MB=200

CHAT_HISTORY_MAX_MESSAGES=20
CHAT_HISTORY_MAX_TOKENS=8000
RETRIEVAL_DOCUMENT_BATCH_SIZE=500
RETRIEVAL_MAX_PARALLEL_SLICES=8
DEBUG_CONTENT_LOGGING=false

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Filesystem connector: alias=absolute_path pairs (comma-separated)
KNOWLEDGE_CONNECTOR_FS_ROOTS=documents=/data/company-documents

# AES-256-GCM master key for connector credentials (64-char hex recommended)
KNOWLEDGE_CONNECTOR_MASTER_KEY=

# Optional private network allowlist for HTTP connectors (CIDR or IP, comma-separated)
KNOWLEDGE_HTTP_PRIVATE_NETWORK_ALLOWLIST=
