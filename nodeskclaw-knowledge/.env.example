APP_NAME=nodeskclaw-knowledge
APP_VERSION=dev
DEBUG=false
HOST=0.0.0.0
PORT=4530

DATABASE_URL=postgresql+asyncpg://nodeskclaw:nodeskclaw@postgres:5432/nodeskclaw_knowledge
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20

NODESKCLAW_BACKEND_URL=http://nodeskclaw-backend:8000
