APP_NAME=nodeskclaw-knowledge
APP_VERSION=dev
DEBUG=false
HOST=0.0.0.0
PORT=4530

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nodeskclaw_knowledge
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20

JWT_SECRET=replace-with-nodeskclaw-backend-secret
JWT_ALGORITHM=HS256

NODESKCLAW_BACKEND_URL=http://127.0.0.1:4510
NODESKCLAW_KNOWLEDGE_CONTEXT_PATH=/api/v1/auth/knowledge-context
MEMBER_CONTEXT_TTL_SECONDS=0

RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=replace-with-ragflow-api-key
RAGFLOW_TIMEOUT_SECONDS=60
RAGFLOW_UPLOAD_TIMEOUT_SECONDS=120

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000
