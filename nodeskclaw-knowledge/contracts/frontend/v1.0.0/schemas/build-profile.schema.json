{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nodeskclaw:knowledge:frontend:v1:build-profile",
  "title": "BuildProfile",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "system_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_system": {
      "type": "boolean"
    },
    "index_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trigger_policy": {
      "type": "object"
    },
    "artifact_trigger_policy": {
      "type": "object"
    },
    "version": {
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "name"
  ]
}
