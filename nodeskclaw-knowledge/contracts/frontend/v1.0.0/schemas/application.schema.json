{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nodeskclaw:knowledge:frontend:v1:application",
  "title": "KnowledgeApplication",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "org_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_member_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "disabled"
      ]
    },
    "answer_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "active_profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "acl_version": {
      "type": "integer"
    },
    "visibility": {
      "type": "string"
    },
    "knowledge_set_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_job_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "org_id",
    "name",
    "owner_member_id",
    "status",
    "acl_version",
    "visibility",
    "knowledge_set_ids"
  ]
}
