{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nodeskclaw:knowledge:frontend:v1:knowledge-base-create",
  "title": "KnowledgeBaseCreate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "embedding_model": {
      "type": "string"
    },
    "chunk_method": {
      "type": "string"
    },
    "parser_config": {
      "type": [
        "object",
        "null"
      ]
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "department",
        "organization"
      ]
    },
    "tags": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "name"
  ]
}
