{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nodeskclaw:knowledge:frontend:v1:quality-snapshot",
  "title": "QualitySnapshot",
  "type": "object",
  "properties": {
    "score_status": {
      "type": "string"
    },
    "subscores": {
      "type": "object"
    },
    "data_coverage": {
      "type": "object"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "calculated_at": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "score_status"
  ]
}
