{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nodeskclaw:knowledge:frontend:v1:ingestion-job",
  "title": "IngestionJob",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "source_file_id": {
      "type": "string"
    },
    "file_version_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "uploading",
        "upload_unknown",
        "ragflow_uploaded",
        "metadata_synced",
        "parse_dispatched",
        "parsing",
        "validating",
        "active",
        "failed",
        "cancelled"
      ]
    },
    "progress": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt_count": {
      "type": "integer"
    },
    "max_attempts": {
      "type": "integer"
    },
    "next_run_at": true,
    "finished_at": true,
    "created_by_member_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "source_file_id",
    "file_version_id",
    "status",
    "progress",
    "attempt_count",
    "max_attempts"
  ]
}
