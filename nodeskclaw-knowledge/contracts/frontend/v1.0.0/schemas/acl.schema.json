{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nodeskclaw:knowledge:frontend:v1:acl",
  "title": "Acl",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "subject_type": {
      "type": "string",
      "enum": [
        "member",
        "role",
        "department",
        "organization"
      ]
    },
    "subject_id": {
      "type": "string"
    },
    "permission": {
      "type": "string"
    },
    "effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny"
      ]
    },
    "created_by_member_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "subject_type",
    "subject_id",
    "permission",
    "effect",
    "created_by_member_id"
  ]
}
