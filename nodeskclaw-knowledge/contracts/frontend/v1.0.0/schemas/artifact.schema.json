{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nodeskclaw:knowledge:frontend:v1:artifact",
  "title": "KnowledgeArtifact",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "knowledge_base_id": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "source_file_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "file_version_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "active_revision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_manifest_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_built_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_validated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    }
