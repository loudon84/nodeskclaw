{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nodeskclaw:knowledge:frontend:v1:release",
  "title": "KnowledgeRelease",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "validating",
        "validated",
        "promoted",
        "superseded",
        "retired",
        "failed"
      ]
    },
    "release_manifest": {
      "type": "object"
    },
    "manifest_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "quality_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "validation_job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_by_member_id": {
      "type": "string"
    },
    "promoted_at": true,
    "retired_at": true,
    "validation_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": true
  },
  "additionalProperties": false,
  "required": [
    "id",
    "application_id",
    "version",
    "status",
    "release_manifest",
    "created_by_member_id"
  ]
}
