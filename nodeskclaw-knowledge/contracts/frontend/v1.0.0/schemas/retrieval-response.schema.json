{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nodeskclaw:knowledge:frontend:v1:retrieval-response",
  "title": "ApplicationRetrievalData",
  "type": "object",
  "properties": {
    "application_id": {
      "type": "string"
    },
    "release_id": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "preview",
        "stable"
      ]
    },
    "manifest_hash": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "empty",
        "degraded"
      ]
    },
    "answer_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "knowledge_set_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "chunks": {
      "type": "array",
      "items": {
        "$ref": "urn:nodeskclaw:knowledge:frontend:v1:evidence-item"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "application_id",
    "release_id",
    "channel",
    "manifest_hash"
  ]
}
