{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nodeskclaw:knowledge:frontend:v1:knowledge-set-update",
  "title": "KnowledgeSetUpdate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ]
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "department",
        "organization"
      ]
    },
    "retrieval_config": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
