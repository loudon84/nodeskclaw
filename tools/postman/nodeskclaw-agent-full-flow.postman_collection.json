    },
    {
      "name": "24 - List Persisted Artifacts",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Skill-Agent-Token", "value": "{{agent_internal_token}}" }, { "key": "X-Exec-Org-Id", "value": "{{org_id}}" }],
        "url": { "raw": "{{agent_base_url}}/internal/v1/runs/{{artifact_run_id}}/artifacts" }
