        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"agent-debug.txt\",\n  \"content_type\": \"text/plain\",\n  \"content_base64\": \"{{artifact_content_base64}}\",\n  \"checksum_sha256\": \"{{artifact_checksum_sha256}}\",\n  \"generation\": {{artifact_run_generation}},\n  \"size\": {{artifact_size}},\n  \"upload_mode\": \"eager\",\n  \"idempotency_key\": \"artifact-{{artifact_run_id}}\"\n}" },
