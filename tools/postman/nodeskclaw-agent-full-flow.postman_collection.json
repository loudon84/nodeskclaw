{
  "info": {
    "_postman_id": "9f30d8f5-4776-4ef0-91ef-153000000001",
    "name": "DeskClaw 团队版 - NoDeskClaw Agent Full Flow Manual Debug",
    "description": "用于人工启动 Backend/Agent 后逐项调试 nodeskclaw-agent 全流程。集合不包含有效凭证；先填写 backend_access_token、org_id、user_id、other_org_id、agent_internal_token。请求按编号顺序手工执行。01-08 准备 Skill 与 Edge 节点；10-18 验证 Central/Approval/Cancel；20-30 验证 Event 与 Artifact；40-52 验证 Edge Job、Lease、Event 与 on-demand Artifact；60-68 验证 Installation Generation。Edge 协议段使用集合新注册的独立 Edge 节点，避免与真实 Edge Worker 抢占。真实 Edge install/uninstall 副作用需改用实际 Edge Worker 的 node/token 后观察本地安装目录，本集合只验证其控制面合同。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function ensure(key, value) { if (!pm.collectionVariables.get(key)) pm.collectionVariables.set(key, value); }",
          "const suffix = Date.now().toString();",
          "ensure('skill_key', 'postman-agent-' + suffix);",
          "ensure('release_version', '1.0.' + suffix.slice(-6));",
          "ensure('central_run_id', 'run-central-' + pm.variables.replaceIn('{{$guid}}'));",
          "ensure('cancel_run_id', 'run-cancel-' + pm.variables.replaceIn('{{$guid}}'));",
          "ensure('artifact_run_id', 'run-artifact-' + pm.variables.replaceIn('{{$guid}}'));",
          "ensure('edge_run_id', 'run-edge-' + pm.variables.replaceIn('{{$guid}}'));",
          "ensure('approval_id', 'approval-' + pm.variables.replaceIn('{{$guid}}'));",
          "ensure('source_event_id', 'event-' + pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    }
  ],
  "variable": [
    { "key": "backend_base_url", "value": "http://127.0.0.1:4510" },
    { "key": "agent_base_url", "value": "http://127.0.0.1:4580" },
