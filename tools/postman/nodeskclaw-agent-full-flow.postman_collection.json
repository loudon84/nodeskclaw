      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Artifact run query is 200', () => pm.response.to.have.status(200));", "const j = pm.response.json(); pm.collectionVariables.set('artifact_run_generation', String(j.generation)); pm.collectionVariables.set('stale_artifact_generation', String(j.generation + 1));"] } }]
