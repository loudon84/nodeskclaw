      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Repeated cancel is 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('CANCELLED');"] } }]
    },
    {
      "name": "20 - Create Artifact Run",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Skill-Agent-Token", "value": "{{agent_internal_token}}" },
          { "key": "X-Exec-Org-Id", "value": "{{org_id}}" },
          { "key": "X-Exec-User-Id", "value": "{{user_id}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"run_id\": \"{{artifact_run_id}}\", \"tool_name\": \"postman_artifact_debug\", \"requires_approval\": true, \"placement\": {\"role\": \"central\"}, \"idempotency_key\": \"postman-artifact-{{artifact_run_id}}\"}" },
        "url": { "raw": "{{agent_base_url}}/internal/v1/runs" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Artifact run create is 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('WAITING_APPROVAL');"] } }]
    },
    {
      "name": "21 - Get Artifact Run Generation",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Skill-Agent-Token", "value": "{{agent_internal_token}}" }, { "key": "X-Exec-Org-Id", "value": "{{org_id}}" }],
        "url": { "raw": "{{agent_base_url}}/internal/v1/runs/{{artifact_run_id}}" }
