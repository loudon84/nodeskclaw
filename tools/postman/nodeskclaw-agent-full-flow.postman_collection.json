        "body": { "mode": "raw", "raw": "{\"run_id\": \"{{cancel_run_id}}\", \"tool_name\": \"postman_cancel_debug\", \"requires_approval\": true, \"placement\": {\"role\": \"central\"}, \"idempotency_key\": \"postman-cancel-{{cancel_run_id}}\"}" },
        "url": { "raw": "{{agent_base_url}}/internal/v1/runs" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Cancel run create is 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('WAITING_APPROVAL');"] } }]
    },
    {
      "name": "17 - Cancel Run",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-Skill-Agent-Token", "value": "{{agent_internal_token}}" }, { "key": "X-Exec-Org-Id", "value": "{{org_id}}" }],
        "url": { "raw": "{{agent_base_url}}/internal/v1/runs/{{cancel_run_id}}/cancel" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Cancel is 200', () => pm.response.to.have.status(200));", "const j = pm.response.json(); pm.expect(j.status).to.eql('CANCELLED'); pm.expect(j.idempotent).to.eql(true);"] } }]
    },
    {
      "name": "18 - Repeat Cancel Idempotently",
