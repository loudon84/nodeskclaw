        "url": { "raw": "{{agent_base_url}}/internal/v1/runs/{{central_run_id}}/events?after_seq=0" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Event replay is 200', () => pm.response.to.have.status(200));", "const j = pm.response.json(); pm.expect(j.run_id).to.eql(pm.collectionVariables.get('central_run_id')); pm.expect(j.items).to.be.an('array'); pm.expect(j.next_seq).to.be.a('number');"] } }]
    },
    {
      "name": "14 - Get Central Run Result",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Skill-Agent-Token", "value": "{{agent_internal_token}}" }, { "key": "X-Exec-Org-Id", "value": "{{org_id}}" }],
        "url": { "raw": "{{agent_base_url}}/internal/v1/runs/{{central_run_id}}/result" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Result query is 200', () => pm.response.to.have.status(200));", "const j = pm.response.json(); pm.expect(j.run_id).to.eql(pm.collectionVariables.get('central_run_id')); pm.expect(j.status).to.eql('WAITING_APPROVAL');"] } }]
    },
    {
      "name": "15 - Approve Central Run",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Skill-Agent-Token", "value": "{{agent_internal_token}}" },
          { "key": "X-Exec-Org-Id", "value": "{{org_id}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"evidence\": {\"source\": \"postman\", \"decision\": \"approved\"}}" },
        "url": { "raw": "{{agent_base_url}}/internal/v1/runs/{{central_run_id}}/approvals/{{approval_id}}" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Approval is 200', () => pm.response.to.have.status(200));", "const j = pm.response.json(); pm.expect(j.run_id).to.eql(pm.collectionVariables.get('central_run_id')); pm.expect(j.status).to.eql('RESUMING');"] } }]
    },
    {
