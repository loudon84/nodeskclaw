          { "key": "X-Exec-Org-Id", "value": "{{org_id}}" },
          { "key": "X-Exec-User-Id", "value": "{{user_id}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"run_id\": \"{{central_run_id}}\",\n  \"tool_name\": \"postman_agent_debug\",\n  \"skill_id\": \"{{skill_key}}\",\n  \"skill_release_id\": \"{{release_id}}\",\n  \"placement\": {\"role\": \"central\", \"engine\": \"hermes\"},\n  \"arguments\": {\"message\": \"manual central run\"},\n  \"requires_approval\": true,\n  \"request_trace_id\": \"postman-central-{{central_run_id}}\",\n  \"idempotency_key\": \"postman-central-{{central_run_id}}\"\n}" },
        "url": { "raw": "{{agent_base_url}}/internal/v1/runs" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Central run create is 200', () => pm.response.to.have.status(200));", "const j = pm.response.json(); pm.expect(j.run_id).to.eql(pm.collectionVariables.get('central_run_id')); pm.expect(j.status).to.eql('WAITING_APPROVAL');"] } }]
    },
    {
