        "url": { "raw": "{{backend_base_url}}/api/v1/internal/edge/installations/desired" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Uninstall desired pull is 200', () => pm.response.to.have.status(200));", "const item = pm.response.json().data.items.find(x => x.id === pm.collectionVariables.get('installation_id')); pm.expect(item.desired_status).to.eql('uninstalling'); pm.expect(String(item.desired_generation)).to.eql(pm.collectionVariables.get('installation_generation'));"] } }]
    },
    {
      "name": "68 - Report Installation Uninstalled",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-Edge-Token", "value": "{{edge_token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"installation_id\": \"{{installation_id}}\", \"actual_status\": \"uninstalled\", \"generation\": {{installation_generation}}, \"meta\": {\"source\": \"postman-control-contract\"}}" },
        "url": { "raw": "{{backend_base_url}}/api/v1/internal/edge/installations/actual" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Installation uninstalled report is 200', () => pm.response.to.have.status(200));", "const j = pm.response.json(); pm.expect(j.code).to.eql(0); pm.expect(j.data.actual_status).to.eql('uninstalled');"] } }]
    }
  ]
}
