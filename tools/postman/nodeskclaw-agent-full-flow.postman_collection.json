  "item": [
    {
      "name": "01 - Backend Health",
      "request": { "method": "GET", "url": { "raw": "{{backend_base_url}}/api/v1/health" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Backend health is 200', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "02 - Agent Live",
      "request": { "method": "GET", "url": { "raw": "{{agent_base_url}}/health/live" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Agent live is 200', () => pm.response.to.have.status(200));", "pm.test('Agent reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"] } }]
    },
    {
      "name": "03 - Agent Ready",
      "request": { "method": "GET", "url": { "raw": "{{agent_base_url}}/health/ready" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Agent readiness is 200', () => pm.response.to.have.status(200));", "pm.test('Agent reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"] } }]
    },
    {
      "name": "04 - Create Debug Skill",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{backend_access_token}}" },
          { "key": "X-Org-Id", "value": "{{org_id}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"skill_id\": \"{{skill_key}}\",\n  \"name\": \"Postman Agent Debug Skill\",\n  \"tool_name\": \"postman_agent_debug\",\n  \"version\": \"{{release_version}}\",\n  \"runtime\": \"hermes\",\n  \"is_mcp_exposed\": false,\n  \"input_schema\": {\"type\": \"object\"},\n  \"output_schema\": {\"type\": \"object\"}\n}" },
        "url": { "raw": "{{backend_base_url}}/api/v1/hermes/skills" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Skill create is 200', () => pm.response.to.have.status(200));", "const j = pm.response.json(); pm.expect(j.code).to.eql(0); pm.expect(j.data.id).to.be.a('string'); pm.collectionVariables.set('skill_db_id', j.data.id);"] } }]
    },
    {
      "name": "05 - Create Skill Release",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{backend_access_token}}" },
          { "key": "X-Org-Id", "value": "{{org_id}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"version\": \"{{release_version}}\", \"notes\": \"Postman manual debug release\"}" },
        "url": { "raw": "{{backend_base_url}}/api/v1/hermes/skills/{{skill_key}}/releases" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Release create is 200', () => pm.response.to.have.status(200));", "const j = pm.response.json(); pm.expect(j.code).to.eql(0); pm.expect(j.data.id).to.be.a('string'); pm.collectionVariables.set('release_id', j.data.id);"] } }]
    },
    {
      "name": "06 - Publish Skill Release",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{backend_access_token}}" },
          { "key": "X-Org-Id", "value": "{{org_id}}" }
        ],
        "url": { "raw": "{{backend_base_url}}/api/v1/hermes/skills/{{skill_key}}/releases/{{release_id}}/publish" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Release publish is 200', () => pm.response.to.have.status(200));", "const j = pm.response.json(); pm.expect(j.code).to.eql(0); pm.expect(j.data.status).to.eql('published');"] } }]
    },
    {
      "name": "07 - Register Isolated Edge Node",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{backend_access_token}}" },
          { "key": "X-Org-Id", "value": "{{org_id}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"name\": \"Postman Isolated Edge Node\"}" },
        "url": { "raw": "{{backend_base_url}}/api/v1/hermes/edge-nodes" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Edge node register is 200', () => pm.response.to.have.status(200));", "const j = pm.response.json(); pm.expect(j.code).to.eql(0); pm.expect(j.data.node.id).to.be.a('string'); pm.expect(j.data.token).to.be.a('string'); pm.collectionVariables.set('edge_node_id', j.data.node.id); pm.collectionVariables.set('edge_token', j.data.token);"] } }]
    },
    {
      "name": "08 - Edge Heartbeat",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-Edge-Token", "value": "{{edge_token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"node_id\": \"{{edge_node_id}}\", \"status_meta\": {\"source\": \"postman-manual-debug\"}}" },
        "url": { "raw": "{{backend_base_url}}/api/v1/internal/edge/heartbeat" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Edge heartbeat is 200', () => pm.response.to.have.status(200));", "const j = pm.response.json(); pm.expect(j.code).to.eql(0); pm.expect(j.data.node_id).to.eql(pm.collectionVariables.get('edge_node_id'));"] } }]
    },
    {
