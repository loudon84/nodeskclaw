{
  "name": "integration-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/integration",
  "projectType": "library",
  "tags": ["type:e2e", "scope:cross"],
  "implicitDependencies": ["desktop", "runtime", "runtime-client-ts"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/integration/run-smoke.mjs",
        "env": {
          "INTEGRATION_LEVEL": "all"
        }
      }
    },
    "test-l1": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/integration/run-smoke.mjs",
        "env": {
          "INTEGRATION_LEVEL": "l1"
        }
      }
    },
    "test-l2": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/integration/run-smoke.mjs",
        "env": {
          "INTEGRATION_LEVEL": "l2"
        }
      }
    },
    "test-l3": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/integration/run-smoke.mjs",
        "env": {
          "INTEGRATION_LEVEL": "all",
          "INTEGRATION_L3": "1"
        }
      }
    }
  }
}
