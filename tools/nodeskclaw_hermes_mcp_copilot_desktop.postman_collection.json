    {
      "name": "02 Hermes MCP - tools/list 与 tools/call",
      "item": [
        {
          "name": "MCP initialize",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/hermes/mcp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "hermes",
                "mcp"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"init-1\",\n  \"method\": \"initialize\",\n  \"params\": {\n    \"clientInfo\": {\n      \"name\": \"copilot-desktop\",\n      \"version\": \"0.1.0\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "MCP tools/list",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/hermes/mcp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "hermes",
                "mcp"
              ]
            },
            "description": "先执行此请求，从返回 tools 中确认 writing skill 的真实 tool_name。必要时更新 collection 变量 tool_name。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"tools-1\",\n  \"method\": \"tools/list\",\n  \"params\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"tools/list ok\", function () { pm.expect(json.result || json.data || json.error).to.exist; });",
                  "console.log(JSON.stringify(json, null, 2));"
                ]
              }
            }
          ]
        },
        {
          "name": "MCP tools/call - common-writer writing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/hermes/mcp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "hermes",
                "mcp"
              ]
            },
            "description": "通过 _routing 指定 common-writer。_routing 会被 backend 剥离，不传给 Hermes Agent。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"call-writing-1\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"{{tool_name}}\",\n    \"arguments\": {\n      \"requirement\": \"请生成一篇 800 字中文文章，主题：企业 AI 员工如何提升运营效率。\",\n      \"title\": \"企业 AI 员工提效说明\",\n      \"format\": \"markdown\",\n      \"_routing\": {\n        \"agent_id\": \"{{agent_id}}\",\n        \"profile_id\": \"{{profile_id}}\",\n        \"workspace_id\": \"{{workspace_id}}\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"tools/call accepted or error returned\", function () { pm.expect(json.result || json.error).to.exist; });",
                  "const sc = json?.result?.structuredContent || json?.data?.structuredContent || {};",
                  "if (sc.task_id) {",
                  "  pm.collectionVariables.set(\"task_id\", sc.task_id);",
                  "  pm.collectionVariables.set(\"task_no\", sc.task_no || \"\");",
                  "  pm.collectionVariables.set(\"event_url\", sc.event_url || \"\");",
                  "  pm.collectionVariables.set(\"artifact_url\", sc.artifact_url || \"\");",
                  "  pm.collectionVariables.set(\"installation_id\", sc.installation_id || \"\");",
                  "}",
                  "console.log(JSON.stringify(json, null, 2));"
                ]
              }
            }
          ]
        }
      ]
    },
