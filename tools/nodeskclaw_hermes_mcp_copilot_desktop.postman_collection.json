  "item": [
    {
      "name": "01 Auth - 登录与令牌",
      "item": [
        {
          "name": "Account login - /auth/account-login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/account-login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "auth",
                "account-login"
              ]
            },
            "description": "统一账号登录。源码中 account-login 接收 account/password，返回 access_token/refresh_token。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"{{account}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"login success\", function () { pm.expect(json.code).to.eql(0); });",
                  "if (json.data) {",
                  "  pm.collectionVariables.set(\"access_token\", json.data.access_token);",
                  "  pm.collectionVariables.set(\"refresh_token\", json.data.refresh_token);",
                  "  if (json.data.user) {",
                  "    pm.collectionVariables.set(\"user_id\", json.data.user.id || \"\");",
                  "    pm.collectionVariables.set(\"current_org_id\", json.data.user.current_org_id || \"\");",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Email login - /auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/login",
              "host": [
