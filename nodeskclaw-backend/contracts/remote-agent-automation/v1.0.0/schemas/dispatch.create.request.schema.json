{
  "$id": "remote-agent-automation.dispatch.create.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dispatch_id",
    "invocation_id",
    "org_id",
    "owner_user_id",
    "client_request_id",
    "agent_ref",
    "prompt"
  ],
  "properties": {
    "dispatch_id": { "type": "string", "minLength": 1 },
    "invocation_id": { "type": "string", "minLength": 1 },
    "org_id": { "type": "string", "minLength": 1 },
    "owner_user_id": { "type": "string", "minLength": 1 },
    "client_request_id": {
      "type": "string",
      "pattern": "^autotask:.+"
    },
    "agent_ref": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string" },
    "knowledge_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "connector_binding_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "integration_account_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "session_ref": { "type": ["string", "null"] },
    "automation_context": { "type": "object" }
  }
}
