{
  "$defs": {
    "ExecutionSnapshot": {
      "properties": {
        "skill_id": {
          "title": "Skill Id",
          "type": "string"
        },
        "skill_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Version"
        },
        "skill_release_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Release Id"
        },
        "skill_release_digest": {
          "title": "Skill Release Digest",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "workspace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Id"
        },
        "attachment_refs": {
          "items": {
            "type": "string"
          },
          "title": "Attachment Refs",
          "type": "array"
        },
        "knowledge_refs": {
          "items": {
            "type": "string"
          },
          "title": "Knowledge Refs",
          "type": "array"
        },
        "connector_binding_refs": {
          "items": {
            "type": "string"
          },
          "title": "Connector Binding Refs",
          "type": "array"
        },
        "model_policy": {
          "additionalProperties": true,
          "title": "Model Policy",
          "type": "object"
        },
        "runtime_policy": {
          "additionalProperties": true,
          "title": "Runtime Policy",
          "type": "object"
        },
        "placement": {
          "additionalProperties": true,
          "title": "Placement",
          "type": "object"
        },
        "snapshot_hash": {
          "title": "Snapshot Hash",
          "type": "string"
        }
      },
      "required": [
        "skill_id",
        "skill_release_digest",
        "snapshot_hash"
      ],
      "title": "ExecutionSnapshot",
      "type": "object"
    }
  },
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "org_id": {
      "title": "Org Id",
      "type": "string"
    },
    "user_id": {
      "title": "User Id",
      "type": "string"
    },
    "tool_name": {
      "title": "Tool Name",
      "type": "string"
    },
    "status": {
      "enum": [
        "CREATED",
        "QUEUED",
        "PREPARING",
        "RUNNING",
        "WAITING_APPROVAL",
        "RESUMING",
        "CANCELLING",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "TIMED_OUT"
      ],
      "title": "Status",
      "type": "string"
    },
    "snapshot": {
      "$ref": "#/$defs/ExecutionSnapshot"
    },
    "attempt_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Id"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "org_id",
    "user_id",
    "tool_name",
    "status",
    "snapshot",
    "created_at",
    "updated_at"
  ],
  "title": "RunRecord",
  "type": "object"
}
