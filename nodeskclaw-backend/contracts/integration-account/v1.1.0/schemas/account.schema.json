    "provider": {
      "type": "string",
      "minLength": 1
    },
    "toolkit_slug": {
      "type": "string",
      "minLength": 1
    },
    "alias": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "AUTHORIZING",
        "ACTIVE",
        "DISCONNECTED"
      ]
    },
    "connected_account_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "ownership": {
      "type": "string",
      "enum": [
        "PERSONAL",
        "ORGANIZATION"
      ]
    },
    "can_use": {
      "type": "boolean"
    },
    "can_manage": {
      "type": "boolean"
    }
  }
