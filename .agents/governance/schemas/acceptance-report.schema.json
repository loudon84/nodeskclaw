{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "report_version",
    "feature_id",
    "work_package_id",
    "source_revision",
    "repository_commit",
    "status",
    "results",
    "generated_at"
  ],
  "properties": {
    "report_version": {
      "enum": [
        "2"
      ]
    },
    "feature_id": {
      "type": "string"
    },
    "work_package_id": {
      "type": "string"
    },
    "source_revision": {
      "type": "string"
    },
    "repository_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "verification_id",
          "status",
          "exit_code",
          "duration_ms"
        ],
        "properties": {
          "verification_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIPPED"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "duration_ms": {
            "type": "integer"
          },
          "stdout_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "stderr_sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
