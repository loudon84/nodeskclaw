{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "attestation_version",
    "provider",
    "repository",
    "repository_id",
    "commit",
    "workflow",
    "run_id",
    "artifact_name",
    "report_sha256",
    "manifest_sha256",
    "generated_at"
  ],
  "properties": {
    "attestation_version": {
      "const": "1"
    },
    "provider": {
      "const": "github-actions"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "repository_id": {
      "type": "string"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "workflow_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "run_id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "job_id": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_name": {
      "type": "string",
      "minLength": 1
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "generated_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
