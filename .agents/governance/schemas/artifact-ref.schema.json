{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smc.local/schemas/artifact-ref-v2.json",
  "title": "ArtifactRef v2",
  "type": "object",
  "required": [
    "repository_id",
    "path",
    "commit",
    "blob_sha",
    "sha256",
    "artifact_type",
    "artifact_id",
    "status",
    "source_revision"
  ],
  "properties": {
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\./).+"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "blob_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "artifact_type": {
      "enum": [
        "SOURCE_PRD",
        "STAGE_PRD",
        "PLAN",
        "VERIFICATION",
        "BUILD",
        "RELEASE"
      ]
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
