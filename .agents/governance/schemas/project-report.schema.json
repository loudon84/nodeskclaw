{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "report_version",
    "project_id",
    "repository_id",
    "kit_version",
    "governance_policy",
    "enforcement"
  ],
  "properties": {
    "report_version": {"enum": ["1", "2"]},
    "project_id": {"type": "string"},
    "repository_id": {"type": "string"},
    "kit_version": {"type": "string"},
    "kit": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "tag": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"]},
        "manifest_sha256": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "governance_policy": {"type": "string"},
    "central_commit": {"type": ["string", "null"]},
    "enforcement": {"type": "boolean"},
    "reported_at": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
