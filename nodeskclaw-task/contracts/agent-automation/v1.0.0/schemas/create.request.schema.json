{
  "$id": "agent-automation.create.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "agent_ref"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "agent_ref": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "prompt_template": { "type": "string" },
    "input_schema": { "type": "object" },
    "knowledge_refs": { "type": "array", "items": { "type": "string" } },
    "connector_binding_refs": { "type": "array", "items": { "type": "string" } },
    "integration_account_refs": { "type": "array", "items": { "type": "string" } },
    "manual_run_enabled": { "type": "boolean" },
    "concurrency_policy": { "type": "string", "enum": ["SKIP_IF_RUNNING", "ALLOW"] },
    "max_concurrent_runs": { "type": "integer", "minimum": 1 },
    "timeout_seconds": { "type": ["integer", "null"] }
  }
}
