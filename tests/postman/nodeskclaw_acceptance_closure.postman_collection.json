    {
      "name": "AC-22 Central Step Plan Persistence",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.expect(pm.response.code).to.equal(200);",
              "});",
              "var data = pm.response.json().data || pm.response.json();",
              "pm.test('Run created and run_id saved', function () {",
              "    pm.expect(data.id || data.run_id).to.be.a('string');",
              "    pm.environment.set('RUN_ID', data.id || data.run_id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "X-Skill-Agent-Token", "value": "{{INTERNAL_TOKEN}}"},
          {"key": "X-Exec-Org-Id", "value": "{{ORG_ID}}"},
          {"key": "X-Exec-User-Id", "value": "{{USER_ID}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tool_name\": \"test_hybrid_tool\",\n  \"arguments\": {\"param\": 1},\n  \"placement\": {\"role\": \"hybrid\", \"engine\": \"hybrid\"},\n  \"snapshot\": {\n    \"placement\": {\"role\": \"hybrid\", \"engine\": \"hybrid\"},\n    \"runtime_policy\": {\n      \"connector_bindings\": [\n        {\"binding_id\": \"job-1\", \"placement\": \"edge\"}\n      ]\n    }\n  }\n}"
        },
