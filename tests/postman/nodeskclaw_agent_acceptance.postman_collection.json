  "item": [
    {
      "name": "AC-01 Central Step Plan Persistence",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 or 201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "var data = pm.response.json().data || pm.response.json();",
              "pm.test('Run created and run_id saved', function () {",
              "    pm.expect(data.id || data.run_id).to.be.a('string');",
              "    pm.environment.set('RUN_ID', data.id || data.run_id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "X-Skill-Agent-Token", "value": "{{INTERNAL_TOKEN}}"},
          {"key": "X-Exec-Org-Id", "value": "{{ORG_ID}}"},
          {"key": "X-Exec-User-Id", "value": "{{USER_ID}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tool_name\": \"test_hybrid_tool\",\n  \"arguments\": {\"param\": 1},\n  \"snapshot\": {\n    \"placement\": {\"mode\": \"hybrid\"},\n    \"steps\": [\n      {\"step_id\": \"central_hermes\", \"owner_role\": \"central\", \"engine\": \"hermes\", \"required\": true},\n      {\"step_id\": \"edge_connector\", \"owner_role\": \"edge\", \"engine\": \"connector\", \"required\": true, \"depends_on\": [\"central_hermes\"]}\n    ]\n  }\n}"
        },
        "url": {
          "raw": "{{AGENT_BASE_URL}}/internal/v1/runs",
          "host": ["{{AGENT_BASE_URL}}"],
          "path": ["internal", "v1", "runs"]
        }
      }
    },
